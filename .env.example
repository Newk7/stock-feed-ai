# ─── PostgreSQL ───────────────────────────────────────
POSTGRES_USER=smartwire
POSTGRES_PASSWORD=smartwire_dev
POSTGRES_DB=smartwire
DATABASE_URL=postgresql://smartwire:smartwire_dev@postgres:5432/smartwire

# ─── S3 / MinIO ──────────────────────────────────────
AWS_ENDPOINT_URL=https://s3.amazonaws.com
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=agentic-smartwire


# Firebase Admin SDK (backend)
FIREBASE_PROJECT_ID=dev-othink
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Firebase Client SDK (frontend)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=dev-othink

# ─── Server ──────────────────────────────────────────
PORT=3001
NODE_ENV=development
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
